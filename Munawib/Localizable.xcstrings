    "محاولات كثيرة غير صحيحة. حاول مجددًا بعد 15 دقيقة.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة غير صحيحة. حاول مجددًا بعد 15 دقيقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many failed attempts. Try again in 15 minutes."
          }
        }
      }
    },
    "انتهت الجلسة، سجّل الدخول مجددًا": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
