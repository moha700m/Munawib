          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account found with this email or employee number"
          }
        }
      }
    },
    "رمز المستشفى غير صحيح": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز المستشفى غير صحيح"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect hospital code"
          }
        }
      }
    },
    "الحساب غير مفعّل، استخدم كود الدعوة من رئيسة التمريض أو المدير": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحساب غير مفعّل، استخدم كود الدعوة من رئيسة التمريض أو المدير"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account not activated. Use the invite code from your head nurse or administrator"
          }
        }
      }
    },
    "لا يوجد اتصال بالإنترنت": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
