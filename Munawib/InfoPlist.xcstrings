{
  "sourceLanguage": "ar",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مِناوب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munawib"
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإضافة مناوباتك إلى التقويم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add your shifts to your calendar."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإضافة مناوباتك إلى التقويم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add your shifts to your calendar."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للدخول السريع إلى حسابك في مِناوب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For quick sign-in to your Munawib account."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج مِناوب الوصول إلى صورك لاختيار صورة الجدول الورقي وقراءة المناوبات منها على جهازك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munawib needs access to your photos to pick a picture of the paper roster and read your shifts from it on your device."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج مِناوب الكاميرا لتصوير الجدول الورقي وقراءة المناوبات منه على جهازك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Munawib needs the camera to photograph the paper roster and read your shifts from it on your device."
          }
        }
      }
    }
  },
  "version": "1.0"
}
